{
  "version": 1,
  "profile": {
    "layout": "nchw",
    "channels": "rgb",
    "normalize": "mean_std",
    "norm_scale": 255,
    "norm_mean": [0.5, 0.5, 0.5],
    "norm_std": [0.5, 0.5, 0.5],
    "pad": "fill",
    "fill_color": [0, 0, 0],
    "activation": "logits",
    "label_format": "json",
    "label_json": {"shape": "blocks", "path": "categories"},
    "category_scheme": "name_string",
    "category_map": {"style": "artist"}
  }
}
